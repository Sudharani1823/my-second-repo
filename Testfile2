 pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/feature/login']],
                    userRemoteConfigs: [[
                        url: 'https://github.com/Sudharani1823/practice-repo.git',
                        credentialsId: 'YOUR_CREDENTIAL_ID'
                    ]]
                ])
            }
        }

        stage('Build') {
            steps {
                echo 'Build successful!'
            }
        }

        stage('Test') {
            steps {
                echo 'Test successful!'
            }
        }
    }

    post {
        success {
            echo 'Jenkins Build SUCCESSFUL'
        }
    }
}