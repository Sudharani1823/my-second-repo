 pipeline {
    agent any
    stages {
        stage('Checkout') {
             when {
                expression {
                    params.DO_CHECKOUT
                  }
             }
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/feature/login']],
                    userRemoteConfigs: [[
                        url: 'git@github.com:Sudharani1823/practice-repo.git',
                        credentialsId: 'github-ssh'
                    ]]
                ])
            }
        }

        stage('Build') {
            steps {
                echo 'Build successful'
            }
        }

        stage('Test') {
            steps {
                echo 'Test successful'
            }
        }
    }
